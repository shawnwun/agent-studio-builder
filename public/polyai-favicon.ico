%26h%3D2160%26fit%3Dmax&#38;w=3840&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 3840w, /_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2F5fb350eba887166e0269c3c442ffa934e3e383a7-3840x2160.jpg%3Fw%3D3840%26h%3D2160%26fit%3Dmax&#38;w=2560&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 2560w, /_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2F5fb350eba887166e0269c3c442ffa934e3e383a7-3840x2160.jpg%3Fw%3D3840%26h%3D2160%26fit%3Dmax&#38;w=1920&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 1920w, /_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2F5fb350eba887166e0269c3c442ffa934e3e383a7-3840x2160.jpg%3Fw%3D3840%26h%3D2160%26fit%3Dmax&#38;w=1280&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 1280w, /_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2F5fb350eba887166e0269c3c442ffa934e3e383a7-3840x2160.jpg%3Fw%3D3840%26h%3D2160%26fit%3Dmax&#38;w=1080&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 1080w, /_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2F5fb350eba887166e0269c3c442ffa934e3e383a7-3840x2160.jpg%3Fw%3D3840%26h%3D2160%26fit%3Dmax&#38;w=960&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 960w, /_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2F5fb350eba887166e0269c3c442ffa934e3e383a7-3840x2160.jpg%3Fw%3D3840%26h%3D2160%26fit%3Dmax&#38;w=640&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 640w, /_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2F5fb350eba887166e0269c3c442ffa934e3e383a7-3840x2160.jpg%3Fw%3D3840%26h%3D2160%26fit%3Dmax&#38;w=320&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 320w" style="background-image:url('data:image/jpeg;base64,')" data-has-placeholder="true" alt sizes="100vw" loading="eager" decoding="sync" fetchpriority="high" width="3840" height="2160" class="iDTCH fit-cover"> </picture> </div> </div></figure></div></section> <script>
  const cleanup = [];
  document.addEventListener('astro:page-load', () => {
    const block = document.querySelector('[data-block-home-page-hero]');
    if (!block) return;

    const headingNotAnimated = block.querySelector('.heading-not-animated');
    if (!headingNotAnimated) return;

    const bodyChildren = block.querySelectorAll('.body-container > *');
    const navigation = document.querySelector('header nav.has-hero');
    const logos = block.querySelector('.animated-logos');
    const logosHeading = block.querySelector('.footer-pt');
    const circlesContainer = block.querySelector('.circle-asset-container');

    const circleStartTime = 0;
    const navStartTime = 1200 + circleStartTime;
    const logoCarouselStartTime = 400 + navStartTime;
    const headingNotAnimatedStartTime = 800 + logoCarouselStartTime;

    // 1. fade in circles
    const fadeInCircleTimeout = setTimeout(() => {
      circlesContainer?.classList.add('show');
    }, circleStartTime);

    // 2. fade in navigation + start fade in body children, staggered
    const fadeInNavTimeout = setTimeout(() => {
      bodyChildren.forEach((child, index) => {
        setTimeout(() => {
          child.classList.add('show');
        }, index * 400);
      });

      navigation?.classList.add('show');
    }, navStartTime);

    // 3. fade in logo carousel
    const fadeInLogoCarouselTimeout = setTimeout(() => {
      logos?.classList.add('show');
      logosHeading?.classList.add('show');
    }, logoCarouselStartTime);

    // 4. fade in "heading not animated", then start animated heading (see component delay prop)
    const fadeInHeadingNotAnimatedTimeout = setTimeout(() => {
      headingNotAnimated.classList.add('show');
    }, headingNotAnimatedStartTime);

    const animatedHeadingStartTimeout = setTimeout(() => {
      window.dispatchEvent(new Event('animated-heading-start'));
    }, headingNotAnimatedStartTime + 800);

    cleanup.push(() => {
      clearTimeout(fadeInCircleTimeout);
      clearTimeout(fadeInNavTimeout);
      clearTimeout(fadeInLogoCarouselTimeout);
      clearTimeout(fadeInHeadingNotAnimatedTimeout);
      clearTimeout(animatedHeadingStartTimeout);
    });
  });

  document.addEventListener('astro:page-unload', () => {
    cleanup.forEach((fn) => fn());
    cleanup.length = 0;
  });
</script><section class="jaIac" data-block-index="1"> <div class="Xlggq container"> <div class="doIOt t_pkhC"><h2 id="heading-finally-someone-who--ing-listens-noeywq" class="heading text-style-heading-regular">Finally. Someone who f<span class="rLVcq" aria-label="censored" style="--aspect-ratio:0.7735849056603774"><span data-icon class="icon " data-astro-cid-ei5r4s44 style="--iconUrl: url(https://cdn.sanity.io/images/u9ir40pr/production/9a2a27415093f627146f8b6d83416fc82bb4341d-41x53.svg);"></span> </span>ing listens.</h2></div> <figure class="poMVU asset sizing-default roundedCorners-false"><div class="GwIiD roundedCornersInner-false" data-type="video" data-target="mobile"> <button class="zwLAc" type="button" data-show-video-button="true" aria-label="Play video"> <svg width="56" height="56" viewBox="0 0 56 56" fill="none" xmlns="http://www.w3.org/2000/svg"> <circle cx="28" cy="28" r="28" fill="#D9EE50"></circle> <path d="M24 35V21L35 28L24 35Z" fill="#151213"></path> </svg> </button> <div class="YcVwz"> <img src="/_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2Faf4cff051842c72b47a6697294b2c4fa47468d6a-864x1080.webp&#38;w=960&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc" srcset="/_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2Faf4cff051842c72b47a6697294b2c4fa47468d6a-864x1080.webp&#38;w=2560&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 2560w, /_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2Faf4cff051842c72b47a6697294b2c4fa47468d6a-864x1080.webp&#38;w=1920&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 1920w, /_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2Faf4cff051842c72b47a6697294b2c4fa47468d6a-864x1080.webp&#38;w=1280&#38;q=100&#38;dpl=dpl_3ayFzq1pvTrWVnrmjHj6cctdnKDc 1280w, /_vercel/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2Fu9ir40pr%2Fproduction%2Faf4cff051842c72b47a6697294b2c4fa47468d6a-864x1080.webp&#38;w=640