# ── Server ────────────────────────────────────────────────────────────────
PORT=8081

# ── PTB (Prompt-to-Build) Python server ───────────────────────────────────
PTB_HOST=localhost:8788
PTB_API_KEY=ptb-dev-changeme

# ── LAS CLI path ──────────────────────────────────────────────────────────
LAS_BIN=/path/to/local_agent_studio/.venv/bin/las

