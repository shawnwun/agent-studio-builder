# ── API Keys (one per user, up to 7) ──────────────────────────────────────
# Generate a strong random key: openssl rand -hex 32
API_KEY_USER1=ptb-user1-changeme
# API_KEY_USER2=ptb-user2-changeme
# API_KEY_USER3=ptb-user3-changeme
# API_KEY_USER4=ptb-user4-changeme
# API_KEY_USER5=ptb-user5-changeme
# API_KEY_USER6=ptb-user6-changeme
# API_KEY_USER7=ptb-user7-changeme

# ── Claude Code ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_BIN=/usr/local/bin/claude

# ── las CLI ────────────────────────────────────────────────────────────────
LAS_BIN=/usr/local/bin/las

# ── Server ────────────────────────────────────────────────────────────────
PORT=8788
JOBS_DIR=/tmp/ptb_jobs

# ── Docker Compose (host paths for binary mounts) ─────────────────────────
CLAUDE_BIN_HOST=/usr/local/bin/claude
LAS_BIN_HOST=/usr/local/bin/las
